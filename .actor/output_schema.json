{
    "actorSpecification": 1,
    "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Shopify product record",
        "description": "One deduplicated record per unique Shopify product, matching main.py's stable output contract. Money values are 2-decimal strings; null means not found (never zero).",
        "type": "object",
        "properties": {
            "schema_version": {
                "type": "string",
                "title": "Schema version",
                "description": "Output contract version, currently 1.0."
            },
            "record_type": {
                "type": "string",
                "title": "Record type",
                "description": "Always shopify_product for this Actor."
            },
            "product_key": {
                "type": "string",
                "title": "Product key",
                "description": "Stable deduplication key: store_domain:handle, or store_domain:url:<sha1> when no handle exists."
            },
            "product_id": {
                "type": ["string", "null"],
                "title": "Product ID",
                "description": "Native Shopify product ID (as string) when discovered."
            },
            "store_domain": {
                "type": "string",
                "title": "Store domain"
            },
            "product_url": {
                "type": "string",
                "title": "Product URL",
                "description": "Normalized requested product URL."
            },
            "canonical_url": {
                "type": "string",
                "title": "Canonical URL",
                "description": "rel=canonical product URL used as the product's stable identity."
            },
            "extracted_at": {
                "type": "string",
                "title": "Extracted at",
                "description": "UTC extraction timestamp, e.g. 2026-10-20T09:15:30Z."
            },
            "title": {
                "type": "string",
                "title": "Product title"
            },
            "handle": {
                "type": ["string", "null"],
                "title": "Handle",
                "description": "Shopify product handle (URL slug)."
            },
            "vendor": {
                "type": ["string", "null"],
                "title": "Vendor / brand"
            },
            "product_type": {
                "type": ["string", "null"],
                "title": "Product type"
            },
            "description_text": {
                "type": ["string", "null"],
                "title": "Description",
                "description": "Cleaned plain-text description."
            },
            "currency": {
                "type": ["string", "null"],
                "title": "Currency",
                "description": "ISO 4217 currency code, e.g. USD. Never guessed."
            },
            "price_min": {
                "type": ["string", "null"],
                "title": "Min price",
                "description": "Lowest variant/offer price as a 2-decimal string, e.g. 49.99. Null when no price was found."
            },
            "price_max": {
                "type": ["string", "null"],
                "title": "Max price",
                "description": "Highest variant/offer price as a 2-decimal string."
            },
            "compare_at_price_min": {
                "type": ["string", "null"],
                "title": "Min compare-at price",
                "description": "Lowest compare-at price as a 2-decimal string."
            },
            "compare_at_price_max": {
                "type": ["string", "null"],
                "title": "Max compare-at price",
                "description": "Highest compare-at price as a 2-decimal string."
            },
            "available": {
                "type": ["boolean", "null"],
                "title": "Available",
                "description": "True when the product (or any variant) is buyable. Null when unknown."
            },
            "options": {
                "type": "array",
                "title": "Product options",
                "items": {
                    "type": "object",
                    "title": "Option",
                    "properties": {
                        "name": {
                            "type": "string",
                            "title": "Option name",
                            "example": "Size"
                        },
                        "values": {
                            "type": "array",
                            "title": "Option values",
                            "items": {
                                "type": "string"
                            },
                            "example": ["S", "M", "L"]
                        }
                    },
                    "required": ["name", "values"]
                }
            },
            "variants": {
                "type": "array",
                "title": "Variants",
                "items": {
                    "type": "object",
                    "title": "Variant",
                    "properties": {
                        "variant_id": {
                            "type": ["string", "null"],
                            "title": "Variant ID"
                        },
                        "title": {
                            "type": ["string", "null"],
                            "title": "Variant title"
                        },
                        "sku": {
                            "type": ["string", "null"],
                            "title": "SKU"
                        },
                        "barcode": {
                            "type": ["string", "null"],
                            "title": "Barcode / GTIN"
                        },
                        "available": {
                            "type": ["boolean", "null"],
                            "title": "Available"
                        },
                        "price": {
                            "type": ["string", "null"],
                            "title": "Price",
                            "description": "2-decimal price string for this variant."
                        },
                        "compare_at_price": {
                            "type": ["string", "null"],
                            "title": "Compare-at price"
                        },
                        "options": {
                            "type": "object",
                            "title": "Selected options",
                            "description": "Map of option name to selected value, e.g. Size -> M.",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "required": ["variant_id", "title", "sku", "barcode", "available", "price", "compare_at_price", "options"]
                }
            },
            "images": {
                "type": "array",
                "title": "Images",
                "description": "Absolute, deduplicated image URLs.",
                "items": {
                    "type": "string",
                    "title": "Image URL"
                }
            },
            "tags": {
                "type": "array",
                "title": "Tags",
                "items": {
                    "type": "string"
                }
            },
            "published_at": {
                "type": ["string", "null"],
                "title": "Published at",
                "description": "UTC ISO-8601 publication timestamp, when discovered."
            },
            "source_fields": {
                "type": "array",
                "title": "Source fields",
                "description": "Extraction tiers that contributed fields to this record.",
                "items": {
                    "type": "string",
                    "enum": ["json_ld", "shopify_meta", "html_metadata"]
                }
            },
            "markdown": {
                "type": ["string", "null"],
                "title": "Markdown",
                "description": "AI-friendly Markdown representation. Present only when the includeMarkdown input is enabled."
            }
        },
        "required": [
            "schema_version",
            "record_type",
            "product_key",
            "product_id",
            "store_domain",
            "product_url",
            "canonical_url",
            "extracted_at",
            "title",
            "handle",
            "vendor",
            "product_type",
            "description_text",
            "currency",
            "price_min",
            "price_max",
            "compare_at_price_min",
            "compare_at_price_max",
            "available",
            "options",
            "variants",
            "images",
            "tags",
            "published_at",
            "source_fields"
        ],
        "additionalProperties": true
    },
    "views": {
        "overview": {
            "title": "Products",
            "transformation": {
                "fields": [
                    "product_key",
                    "title",
                    "vendor",
                    "product_type",
                    "currency",
                    "price_min",
                    "price_max",
                    "available",
                    "store_domain",
                    "product_url",
                    "extracted_at"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "product_url": {
                        "format": "link"
                    },
                    "available": {
                        "format": "boolean"
                    },
                    "extracted_at": {
                        "format": "date"
                    }
                }
            }
        },
        "pricing": {
            "title": "Pricing",
            "transformation": {
                "fields": [
                    "product_key",
                    "title",
                    "currency",
                    "price_min",
                    "price_max",
                    "compare_at_price_min",
                    "compare_at_price_max",
                    "available"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "price_min": {
                        "format": "number"
                    },
                    "price_max": {
                        "format": "number"
                    },
                    "compare_at_price_min": {
                        "format": "number"
                    },
                    "compare_at_price_max": {
                        "format": "number"
                    },
                    "available": {
                        "format": "boolean"
                    }
                }
            }
        },
        "gallery": {
            "title": "Images",
            "transformation": {
                "fields": [
                    "product_key",
                    "title",
                    "images"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "images": {
                        "format": "image"
                    }
                }
            }
        }
    }
}
